# CalmPath AI Assistant - Backend Environment Variables
PORT=5000

# Choose AI Provider: "gemini", "openai", or "mock"
AI_PROVIDER=gemini

# Google Gemini API Key (keep this on the server, NEVER in Android app)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional alternative provider)
OPENAI_API_KEY=
